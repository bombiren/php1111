$id_uzytkownika = isset($_GET["id_uzytkownika"])
    ? (int) $_GET["id_uzytkownika"]
    : 0;

if ($id_uzytkownika > 0) {
    $zapytanie = mysqli_prepare(
        $polaczenie,
        "SELECT
            z.id_zakupu,
            p.nazwa,
            z.ilosc,
            z.cena_transakcji,
            z.ilosc * z.cena_transakcji AS wartosc,
            z.data_zakupu
         FROM zakupy AS z
         INNER JOIN produkty AS p
            ON z.id_produktu = p.id
         WHERE z.id_uzytkownika = ?
         ORDER BY z.data_zakupu DESC"
    );

    mysqli_stmt_bind_param(
        $zapytanie,
        "i",
        $id_uzytkownika
    );

    mysqli_stmt_execute($zapytanie);

    $historia_uzytkownika = mysqli_stmt_get_result($zapytanie);
}

/* Historia zakupów z wybranego dnia */
$data = isset($_GET["data"])
    ? $_GET["data"]
    : date("Y-m-d");

$zapytanie_dnia = mysqli_prepare(
    $polaczenie,
    "SELECT
        z.id_zakupu AS identyfikator_zakupu,
        z.ilosc * z.cena_transakcji AS wartosc,
        z.data_zakupu AS data_zakupu,
        z.ilosc AS ilosc
     FROM zakupy AS z
     WHERE z.data_zakupu = ?
     ORDER BY z.data_zakupu DESC"
);

mysqli_stmt_bind_param(
    $zapytanie_dnia,
    "s",
    $data
);

mysqli_stmt_execute($zapytanie_dnia);

$historia_dnia = mysqli_stmt_get_result($zapytanie_dnia);
