     INNER JOIN produkty AS p
        ON k.id_produktu = p.id
     WHERE k.id_uzytkownika = ?"
);

mysqli_stmt_bind_param(
    $zapytanie,
    "i",
    $id_uzytkownika
);

mysqli_stmt_execute($zapytanie);

$wynik = mysqli_stmt_get_result($zapytanie);
