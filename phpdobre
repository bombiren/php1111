    $zapytanie = mysqli_prepare(
        $polaczenie,
        "DELETE FROM koszyk
         WHERE id_koszyka = ?"
    );

    mysqli_stmt_bind_param(
        $zapytanie,
        "i",
        $id_koszyka
    );

    if (mysqli_stmt_execute($zapytanie)) {
        $komunikat = "Produkt został usunięty z koszyka.";
    }
}

