// OBSŁUGA FORMULARZY
if ($_SERVER["REQUEST_METHOD"] == "POST") {

    // ZADANIE 3 - DODAWANIE UŻYTKOWNIKA
    if (isset($_POST['dodaj_uzytkownika'])) {
        $nazwa = $_POST['nazwa'];
        $email = $_POST['email'];
        $haslo = password_hash($_POST['haslo'], PASSWORD_DEFAULT);

        $stmt = mysqli_prepare($conn,
            "INSERT INTO uzytkownicy (nazwa, email, haslo) VALUES (?, ?, ?)"
        );

        mysqli_stmt_bind_param($stmt, "sss", $nazwa, $email, $haslo);

        if (mysqli_stmt_execute($stmt)) {
            $komunikat = "Użytkownik dodany pomyślnie";
        }
    }

    // ZADANIE 4 - AKTUALIZACJA UŻYTKOWNIKA
    if (isset($_POST['aktualizuj_uzytkownika'])) {
        $id = (int)$_POST['id'];
        $nazwa = $_POST['nazwa'];
        $email = $_POST['email'];

        $stmt = mysqli_prepare($conn,
            "UPDATE uzytkownicy SET nazwa=?, email=? WHERE id=?"
        );

        mysqli_stmt_bind_param($stmt, "ssi", $nazwa, $email, $id);
        mysqli_stmt_execute($stmt);

        $komunikat = "Dane użytkownika zostały zaktualizowane";
    }

    // ZADANIE 5 - USUWANIE UŻYTKOWNIKA
    if (isset($_POST['usun_uzytkownika'])) {
        $id = (int)$_POST['id'];

        $stmt = mysqli_prepare($conn,
            "DELETE FROM uzytkownicy WHERE id=?"
        );

        mysqli_stmt_bind_param($stmt, "i", $id);
        mysqli_stmt_execute($stmt);

        $komunikat = "Użytkownik został usunięty";
    }

    // ZADANIE 7 - DODAWANIE PRODUKTU
    if (isset($_POST['dodaj_produkt'])) {
        $nazwa = $_POST['nazwa'];
        $opis = $_POST['opis'];
        $cena = (float)$_POST['cena'];
        $kategoria = $_POST['kategoria'];

        $stmt = mysqli_prepare($conn,
            "INSERT INTO produkty (nazwa, opis, cena, kategoria)
             VALUES (?, ?, ?, ?)"
        );

        mysqli_stmt_bind_param($stmt, "ssds",
            $nazwa, $opis, $cena, $kategoria
        );

        mysqli_stmt_execute($stmt);

        $komunikat = "Produkt dodany pomyślnie";
    }

    // ZADANIE 8 - AKTUALIZACJA CENY
    if (isset($_POST['aktualizuj_cene'])) {
        $id = (int)$_POST['id'];
        $cena = (float)$_POST['cena'];

        $stmt = mysqli_prepare($conn,
            "UPDATE produkty SET cena=? WHERE id=?"
        );

        mysqli_stmt_bind_param($stmt, "di", $cena, $id);
        mysqli_stmt_execute($stmt);

        $komunikat = "Cena została zaktualizowana";
    }

    // ZADANIE 10 - USUWANIE Z KOSZYKA
    if (isset($_POST['usun_koszyk'])) {
        $id = (int)$_POST['id_koszyka'];

        $stmt = mysqli_prepare($conn,
            "DELETE FROM koszyk WHERE id_koszyka=?"
        );

        mysqli_stmt_bind_param($stmt, "i", $id);
        mysqli_stmt_execute($stmt);

        $komunikat = "Produkt usunięty z koszyka";
    }

    // ZADANIE 13 - USUWANIE HISTORII ZAKUPU
    if (isset($_POST['usun_zakup'])) {
        $id = (int)$_POST['id_zakupu'];

        $stmt = mysqli_prepare($conn,
            "DELETE FROM zakupy WHERE id_zakupu=?"
        );

        mysqli_stmt_bind_param($stmt, "i", $id);
        mysqli_stmt_execute($stmt);

        $komunikat = "Zakup został usunięty";
    }
}
